# Local backend defaults. Copy this file to .env only for local development.
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=data
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Railway runtime values. Railway injects PORT, so do not set PORT there.
# HOST=0.0.0.0
# DATA_DIR=/app/data
# CORS_ORIGINS=https://zidongbx.netlify.app

# Configure all three values on the backend to enable DeepSeek receipt vision.
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash-vision-exp
AI_API_KEY=

# CONCURRENCY must be an integer from 3 through 5. The default is 4.
# CONCURRENCY=4

# Frontend-only public build value. Set this in Netlify, not Railway.
# VITE_API_BASE_URL=https://your-generated-domain.up.railway.app
