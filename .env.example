# DATA_DIR is resolved from the repository root. The default is ./data.
# DATA_DIR=data

# Configure all three values to enable a vision provider.
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=your-vision-model
AI_API_KEY=

# CONCURRENCY must be an integer from 3 through 5. The default is 4.
# CONCURRENCY=4
