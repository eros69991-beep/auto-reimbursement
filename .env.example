# Local backend defaults. Copy this file to .env only for local development.
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=data
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Railway runtime values. Railway injects PORT, so do not set PORT there.
# HOST=0.0.0.0
# DATA_DIR=/app/data
# CORS_ORIGINS=https://zidongbx.netlify.app

# Configure all three values on the backend to enable DeepSeek receipt vision.
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash-vision-exp
AI_API_KEY=

# CONCURRENCY must be an integer from 3 through 5. The default is 4.
# CONCURRENCY=4

# Frontend-only public build value. Set this in Netlify, not Railway.
# VITE_API_BASE_URL=https://your-generated-domain.up.railway.app

# Access code gate for /api (REQUIRED for public deployments).
# Use a random code of 16+ characters (e.g. `openssl rand -base64 18`).
# Store only the SHA-256 of the access code. Generate it with:
#   node -e "console.log(require('crypto').createHash('sha256').update('你的访问码','utf8').digest('hex'))"
# Leave unset ONLY for local development (API stays open with a startup warning).
# ACCESS_CODE_SHA256=

# Reverse-proxy hops in front of the API, used to find the real client IP for
# per-IP rate limiting. Defaults to 1 on Railway (detected from RAILWAY_* vars)
# and 0 locally. Set 2 if another proxy such as Cloudflare sits in front of Railway.
# TRUST_PROXY=1
